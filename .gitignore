# --- build output (keep the shipped exploit/preload.so, drop the objects) ---
# ONE file inside it is a build INPUT, not output: src/su_blob.S .incbin's
# build/embed/su_daemon_arm32, and without that exact blob a fresh clone cannot
# rebuild preload.so at all ("Could not find incbin file"). Keep the directory
# ignored and that file tracked.
exploit/build/*
!exploit/build/embed/
exploit/build/embed/*
!exploit/build/embed/su_daemon_arm32
*.o
*.d

# --- offline analysis scratch: binaries and a KNOWN-BROKEN kallsyms dump -----
# sysmap_a142.txt has mispaired names/addresses; regenerate it, do not trust it.
exploit/tools/test/
exploit/tools/pfnprobe
exploit/tools/sysmap_a142.txt
exploit/tools/__pycache__/
__pycache__/
*.pyc

